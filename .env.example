# Google Gemini API Key (Get free key from https://aistudio.google.com)
GEMINI_API_KEY=

# Optional: OpenAI API Key (if you prefer OpenAI GPT-4o)
OPENAI_API_KEY=

# Razorpay Payment Gateway (Get test keys from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# MongoDB Database (Catalog & Inventory & Suggestions)
MONGODB_URI=mongodb://localhost:27017/grocerai
MONGODB_DB=grocerai

# Cloudinary (Barcode Images & Catalog Storage)
CLOUDINARY_CLOUD_NAME=grocerai
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=grocerai
